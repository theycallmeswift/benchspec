# evalspec credentials — copy to `.env` and fill in what you need.
# `.env` is gitignored and auto-loaded at pytest startup (plugin.py: load_dotenv()).
# You only need credentials for the harnesses your eval sets actually run.

# --- Claude Code (required: the host-side judge always uses Claude) ---
# Prefer the OAuth token from `claude setup-token` for subscription-backed auth;
# otherwise set ANTHROPIC_API_KEY. Set one.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# --- OpenCode harness ---
# Any one provider credential is enough for an OpenCode arm. ANTHROPIC_API_KEY
# above is also honored. GEMINI_API_KEY is injected to the SDK's expected
# GOOGLE_GENERATIVE_AI_API_KEY automatically.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Codex harness ---
# Set one: CODEX_API_KEY (OpenAI API), CODEX_ACCESS_TOKEN (ChatGPT subscription),
# or CODEX_AUTH_JSON_PATH pointing at a Codex CLI auth.json.
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=
CODEX_AUTH_JSON_PATH=

# --- Optional overrides ---
# Default harness when an arm omits one.
# EVALSPEC_AGENT=claude
# Pin CLI versions instead of "latest".
# EVALSPEC_CLAUDE_VERSION=latest
# EVALSPEC_CODEX_VERSION=latest
# EVALSPEC_OPENCODE_VERSION=latest
