# harnessbench credentials — copy to `.env` and fill in what you need.
# `.env` is gitignored; harnessbench loads it before pytest collects anything.
# `GEMINI_API_KEY` is required for every graded run. Other credentials depend on
# the task and judge harnesses you select.

# --- Binder (required for every graded run) ---
GEMINI_API_KEY=

# --- Claude Code harness (and the default judge) ---
# Prefer the OAuth token from `claude setup-token` for subscription-backed auth;
# otherwise set ANTHROPIC_API_KEY. Set one.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# --- OpenCode harness ---
# Any one provider credential is enough for an OpenCode arm. ANTHROPIC_API_KEY
# above is also honored. The binder's GEMINI_API_KEY is injected to the SDK's
# expected GOOGLE_GENERATIVE_AI_API_KEY automatically.
OPENROUTER_API_KEY=

# --- Codex harness ---
# Set one: CODEX_API_KEY (OpenAI API), CODEX_ACCESS_TOKEN (ChatGPT subscription),
# or CODEX_AUTH_JSON_PATH pointing at a Codex CLI auth.json.
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=
CODEX_AUTH_JSON_PATH=

# --- Optional overrides ---
# Trigger-routing harness; output-eval arms use their configured harnesses.
# HARNESSBENCH_AGENT=claude-code
# Pin sandbox task-harness CLI versions instead of "latest".
# HARNESSBENCH_CODEX_VERSION=latest
# HARNESSBENCH_OPENCODE_VERSION=latest
